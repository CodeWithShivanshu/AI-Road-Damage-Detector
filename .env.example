# =============================================================================
# RoadVision AI - Environment Configuration Example
# Copy this file to '.env' and adjust values for your local environment
# =============================================================================

# Inference Settings
CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu

# Tracking Thresholds
TRACKER_MAX_DISTANCE=85.0
TRACKER_MAX_MISSING_FRAMES=18

# Logging
LOG_LEVEL=INFO

# Server & Streaming Options
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEFAULT_PHONE_STREAM_URL=http://127.0.0.1:8080/video

# Google Maps / Location Search API
GOOGLE_MAPS_API_KEY=your_clair_or_google_maps_api_key_here
CLAIR_MAPS_API_URL=https://api.clair.im/v1/google-maps/search
